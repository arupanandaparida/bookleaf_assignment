# Copy to .env in the project root (local) or set as environment variables on your host. NEVER commit real keys.
APP_ENV=development                               # set to "production" on a server
PORT=3001
JWT_SECRET=change-me-to-a-long-random-string      # required (>=16 chars) when APP_ENV=production
DB_PATH=./data/bookleaf.db                        # use a persistent disk path in production

# --- AI (all optional: without a key the app runs with rule-based fallbacks) ---
AI_PROVIDER=anthropic                             # anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL=                                         # default: claude-haiku-5-5 (anthropic) / gpt-4o-mini (openai)
AI_TIMEOUT_MS=15000
AI_BREAKER_THRESHOLD=3                            # consecutive failures before pausing AI calls
AI_BREAKER_COOLDOWN_MS=60000
